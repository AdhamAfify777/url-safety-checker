import os
import re
import base64
import urllib.parse
from urllib.parse import urlparse

# ---------- Colors ----------
CYAN = "\033[96m"
RED = "\033[91m"
YELLOW = "\033[93m"
GREEN = "\033[92m"
RESET = "\033[0m"

# ---------- Clear Screen ----------
def clear():
    os.system("clear")

